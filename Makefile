UUID      := qscreen@rossiandrea.dev
VERSION   := $(shell sed -n 's/.*"version-name": "\(.*\)".*/\1/p' $(UUID)/metadata.json)
SCHEMA    := $(UUID)/schemas/org.gnome.shell.extensions.qscreen.gschema.xml
DIST      := dist

.PHONY: all test test-shell schemas pack install uninstall tarball rpm clean nested

all: pack

test:
	node tests/layouts.test.js
	node tests/reflow.test.js
	glib-compile-schemas --strict --dry-run $(UUID)/schemas

# Needs gjs and the Mutter typelib, so it is not part of `make test`.
MUTTER_TYPELIB ?= $(firstword $(wildcard /usr/lib64/mutter-* /usr/lib/mutter-* /usr/lib/*/mutter-*))

test-shell:
	GI_TYPELIB_PATH=$(MUTTER_TYPELIB) gjs -m tests/session.test.js

schemas:
	glib-compile-schemas $(UUID)/schemas

# Zip suitable for extensions.gnome.org (compiled schemas are generated by the tool).
pack: test
	mkdir -p $(DIST)
	gnome-extensions pack --force --out-dir=$(DIST) \
	    --extra-source=lib --extra-source=stylesheet.css \
	    $(UUID)

install: pack
	gnome-extensions install --force $(DIST)/$(UUID).shell-extension.zip
	@echo "Log out/in (Wayland), then: gnome-extensions enable $(UUID)"

uninstall:
	gnome-extensions uninstall $(UUID)

# Test in a nested shell without touching the real session.
nested: install
	dbus-run-session -- env MUTTER_DEBUG_DUMMY_MODE_SPECS=1280x800 gnome-shell --devkit --wayland

# Source tarball for rpmbuild / COPR.
tarball:
	mkdir -p $(DIST)
	tar czf $(DIST)/qscreen-$(VERSION).tar.gz \
	    --transform 's,^,qscreen-$(VERSION)/,' \
	    $(UUID) tests LICENSE README.md Makefile

rpm: tarball
	rpmbuild -ba packaging/qscreen.spec \
	    --define "_sourcedir $(CURDIR)/$(DIST)" \
	    --define "_rpmdir $(CURDIR)/$(DIST)/rpm" \
	    --define "_srcrpmdir $(CURDIR)/$(DIST)/rpm" \
	    --define "_builddir $(CURDIR)/$(DIST)/build"

clean:
	rm -rf $(DIST) $(UUID)/schemas/gschemas.compiled
